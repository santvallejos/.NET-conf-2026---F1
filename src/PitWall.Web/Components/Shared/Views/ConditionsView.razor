@using PitWall.Web.Components.Panels.Radio
@using PitWall.Web.Components.Shared

@* Condiciones (docs/ui.md §3): Clima ampliado (6), Race Control (7) y Radio. La radio va en un marco de panel porque
   RadioPlayer está pensado para la barra común y no trae el suyo. *@
<div class="view-grid conditions">
    <PanelZone Area="weather" Panels="Weather" />
    <PanelZone Area="race-control" Panels="RaceControl" />
    <section class="panel radio-panel" style="grid-area: radio">
        <RadioPlayer />
    </section>
</div>

@code {
    private static readonly PanelEntry[] Weather = [PanelCatalog.WeatherDetail];
    private static readonly PanelEntry[] RaceControl = [PanelCatalog.RaceControl];
}
