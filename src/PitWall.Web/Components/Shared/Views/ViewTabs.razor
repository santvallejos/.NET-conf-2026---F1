@implements IAsyncDisposable
@inject IJSRuntime JS

<nav class="view-tabs" aria-label="Vistas" @ref="_nav">
    @foreach (var view in ViewCatalog.All)
    {
        var active = view == Active;
        <a href="@view.Route" class="view-tab @(active ? "active" : null)" aria-current="@(active ? "page" : null)"
           data-view-key="@view.Key" data-view-route="@view.Route" data-view-title="@view.Title" title="Tecla @view.Key">
            <span class="key num">@view.Key</span>@view.Title
        </a>
    }
</nav>

@code {
    private ElementReference _nav;
    private IJSObjectReference? _module;
    private IJSObjectReference? _shortcuts;
    private DotNetObjectReference<ViewTabs>? _self;

    [Parameter, EditorRequired]
    public ViewEntry Active { get; set; } = ViewCatalog.Timing;

    /// <summary>Vista elegida con una pestaña o un atajo; la URL ya se actualizó en el navegador.</summary>
    [Parameter, EditorRequired]
    public EventCallback<ViewEntry> OnSelect { get; set; }

    [JSInvokable]
    public Task Select(string route) =>
        ViewCatalog.Find(route) is { } view ? OnSelect.InvokeAsync(view) : Task.CompletedTask;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", $"./{Assets["Components/Shared/Views/ViewTabs.razor.js"]}");
            _self = DotNetObjectReference.Create(this);
            _shortcuts = await _module.InvokeAsync<IJSObjectReference>("register", _nav, _self);
        }
        catch (JSDisconnectedException)
        {
            // La ventana se cerró antes de registrar los atajos: no hay nada que limpiar.
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_shortcuts is not null)
            {
                await _shortcuts.InvokeVoidAsync("dispose");
                await _shortcuts.DisposeAsync();
            }

            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // El circuito ya se cerró: el navegador descartó la página y su listener.
        }

        _self?.Dispose();
        GC.SuppressFinalize(this);
    }
}
