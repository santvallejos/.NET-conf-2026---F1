@using PitWall.Web.Components.Panels.Controls
@using PitWall.Web.Components.Panels.Radio

@* Pantalla única de la charla; es la raíz interactiva (los RenderFragment no cruzan el límite de render mode). *@
<PitWallLayout>
    <TopBar>
        <FlagBar />
        <ReplayControls />
        <RadioPlayer />
    </TopBar>
    <ChildContent>
        <PanelZone Area="left-top" Panels="LeftTop" />
        <PanelZone Area="left-bottom" Panels="LeftBottom" />
        <PanelZone Area="center-top" Panels="CenterTop" />
        <PanelZone Area="center-bottom" Panels="CenterBottom" />
        <PanelZone Area="right-top" Panels="RightTop" />
        <PanelZone Area="right-bottom" Panels="RightBottom" />
        <PanelZone Area="widget-center" Panels="WidgetCenter" />
        <PanelZone Area="widget-right" Panels="WidgetRight" />
    </ChildContent>
</PitWallLayout>

@code {
    // Distribución de docs/ui.md §3; la inyección de eventos va como pestaña junto al mapa para que Monte Carlo y Jev
    // queden a la vista al inyectar.
    private static readonly PanelEntry[] LeftTop = [PanelCatalog.Tower];
    private static readonly PanelEntry[] LeftBottom = [PanelCatalog.Map, PanelCatalog.Scenarios];
    private static readonly PanelEntry[] CenterTop = [PanelCatalog.MonteCarlo];
    private static readonly PanelEntry[] CenterBottom = [PanelCatalog.Tyres, PanelCatalog.Telemetry];
    private static readonly PanelEntry[] RightTop = [PanelCatalog.Jev];
    private static readonly PanelEntry[] RightBottom = [PanelCatalog.JevVsTeam, PanelCatalog.RaceControl];
    private static readonly PanelEntry[] WidgetCenter = [PanelCatalog.Weather];
    private static readonly PanelEntry[] WidgetRight = [PanelCatalog.Energy];
}
