@using PitWall.Web.Components.Panels.Controls
@using PitWall.Web.Components.Panels.Radio
@using PitWall.Web.Components.Shared.Views

@* Raíz interactiva de las 4 vistas: barra común y la vista activa. La vista inicial llega como ruta (un string)
   porque los RenderFragment y los Type no cruzan el límite de render mode; después las pestañas la cambian acá
   mismo (ViewTabs), sin navegación de Blazor, para no rearmar la barra común. *@
<PitWallLayout>
    <TopBar>
        <FlagBar />
        <ReplayControls />
        <div class="view-bar">
            <ViewTabs Active="_view" OnSelect="view => _view = view" />
            <div class="radio-slot">
                <RadioPlayer />
            </div>
        </div>
    </TopBar>
    <ChildContent>
        <DynamicComponent @key="_view" Type="_view.Component" />
    </ChildContent>
</PitWallLayout>

@code {
    private ViewEntry _view = ViewCatalog.Timing;

    /// <summary>Ruta de la vista activa (<see cref="ViewEntry.Route"/>); una desconocida muestra Timing.</summary>
    [Parameter]
    public string ViewRoute { get; set; } = "";

    protected override void OnParametersSet() => _view = ViewCatalog.Find(ViewRoute) ?? ViewCatalog.Timing;
}
