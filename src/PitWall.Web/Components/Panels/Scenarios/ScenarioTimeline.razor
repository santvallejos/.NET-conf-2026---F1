@using PitWall.Domain
@using PitWall.Jev.Serialization
@using PitWall.Strategy.Scenarios
@using PitWall.Web.Components.Shared
@using PitWall.Web.Services
@implements IDisposable
@inject PitWallSession Session
@inject ScenarioService Scenarios
@inject ScenarioStrategyStore Hypothetical
@inject JevDecisionStore Decisions

@{
    var view = Session.View;
    var state = view.State;
    var active = Scenarios.View.Active;
    var hypothetical = state is not null && active is { IsReal: false } && Scenarios.View.SessionKey == state.SessionKey;
    var events = hypothetical ? active!.Events.OrderBy(e => e.Lap).ThenBy(e => e.Id).ToList() : [];
    var effects = hypothetical ? Hypothetical.Effects(state!.SessionKey, active!.Id) : ScenarioEffects.None;
    var decisions = hypothetical
        ? Decisions.Get(state!.SessionKey).Where(decision => decision.ScenarioId == active!.Id).ToList()
        : [];
    // Cada decisión cuelga del evento que disparó su triage (si no se sabe, del último ocurrido hasta su vuelta):
    // evento → decisión de Jev → confianza → reasons.
    var byEvent = decisions
        .Select(decision => (Decision: decision, Event: Hypothetical.EventOf(state!.SessionKey, decision.Id) ?? events.LastOrDefault(e => e.Lap <= decision.Lap)?.Id))
        .Where(pair => pair.Event is not null)
        .GroupBy(pair => pair.Event!.Value)
        .ToDictionary(group => group.Key, group => group.Select(pair => pair.Decision).Reverse().ToList());
    var focus = hypothetical ? Hypothetical.Get(state!.SessionKey, active!.Id, view.FocusDriver)?.Publication.Result.Snapshot : null;
    var best = focus?.Outcomes.FirstOrDefault();
}

<section class="panel scenario-timeline">
    <header class="panel-header">
        <h2>
            Timeline
            @if (hypothetical)
            {
                <span class="tag hypothetical">HIPOTÉTICO</span>
            }
        </h2>
        <span class="panel-meta">@(active?.Name ?? RaceFormat.Missing)</span>
    </header>

    @if (!hypothetical)
    {
        <p class="empty">@(state is null ? "Sin sesión cargada." : "Carrera real: sin eventos inyectados. Inyectá uno para crear un escenario.")</p>
    }
    else
    {
        @if (focus is not null && best is not null)
        {
            <div class="strategy" title="Monte Carlo con los eventos inyectados vigentes">
                <span class="label">MC #@(focus.DriverNumber) V@(focus.Lap)</span>
                <span class="best">@best.StrategyId</span>
                <span class="num">P@(RaceFormat.Number(best.ExpectedPosition))</span>
                <span class="reasons">@Reasons(focus.Reasons)</span>
                <span class="tag hypothetical">HIPOTÉTICO</span>
            </div>
        }

        @if (events.Count == 0)
        {
            <p class="empty">Escenario sin eventos todavía.</p>
        }
        else
        {
            <ol class="timeline">
                @foreach (var injected in events)
                {
                    var own = byEvent.GetValueOrDefault(injected.Id) ?? [];
                    var status = Status(injected, state!.LeaderLap, effects);
                    <li @key="injected.Id">
                        <div class="event">
                            <span class="num lap">V@(injected.Lap)</span>
                            <span class="type">@ScenarioLabels.Of(injected.Type)</span>
                            <span class="params">@ScenarioLabels.Parameters(injected)</span>
                            <span class="status @status.ToLowerInvariant()">@status</span>
                        </div>
                        @if (own.Count > 0)
                        {
                            <ul class="decisions">
                                @foreach (var decision in own.Take(MaxDecisionsPerEvent))
                                {
                                    <li @key="decision.Id">
                                        <span class="driver">@Acronym(view, decision.DriverNumber)</span>
                                        @if (decision.Kind == JevKind.Strategy)
                                        {
                                            <span class="call">@Name(decision.PitCall)</span>
                                            @if (decision.PitCall is PitCall.Box or PitCall.BoxNextLap && decision.Compound is { } compound)
                                            {
                                                <span class="tyre small @RaceFormat.CompoundClass(compound)">@RaceFormat.CompoundLetter(compound)</span>
                                            }
                                            <span class="muted">@Name(decision.EnergyMode)</span>
                                        }
                                        else
                                        {
                                            <span class="call triage">TRIAGE @Name(decision.Impact)</span>
                                        }
                                        <span class="num confidence" title="Confianza">@Percent(decision.Confidence)</span>
                                        <span class="reasons">@Reasons(decision.Reasons)</span>
                                        @if (decision.Hypothetical)
                                        {
                                            <span class="tag hypothetical">HIPOTÉTICO</span>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                        else if (status != Scheduled)
                        {
                            <p class="waiting">Sin decisión de Jev para este evento.</p>
                        }
                    </li>
                }
            </ol>
        }
    }
</section>

@code {
    private const int MaxDecisionsPerEvent = 12;
    private const string Scheduled = "PROGRAMADO";

    protected override void OnInitialized()
    {
        Session.Changed += OnChanged;
        Scenarios.Changed += OnChanged;
        Hypothetical.Changed += OnChanged;
        Decisions.Published += OnPublished;
    }

    public void Dispose()
    {
        Session.Changed -= OnChanged;
        Scenarios.Changed -= OnChanged;
        Hypothetical.Changed -= OnChanged;
        Decisions.Published -= OnPublished;
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnPublished(JevDecision decision) => OnChanged();

    private static string Status(InjectedEvent injected, int currentLap, ScenarioEffects effects) =>
        injected.Lap > currentLap ? Scheduled
        : effects.ActiveEvents.Any(e => e.Id == injected.Id) ? "ACTIVO"
        : "TERMINADO";

    private static string Acronym(PitWallView view, int driverNumber) =>
        view.Drivers.GetValueOrDefault(driverNumber)?.Acronym ?? $"#{driverNumber}";

    private static string Name<TEnum>(TEnum? value)
        where TEnum : struct, Enum =>
        value is { } some ? JevContractNames.Of(some).Replace('_', ' ') : RaceFormat.Missing;

    private static string Percent(double probability) => $"{RaceFormat.Number(probability * 100, "0")}%";

    private static string Reasons(IReadOnlyList<Reason> reasons) =>
        reasons.Count == 0 ? RaceFormat.Missing : string.Join(" · ", reasons.Select(reason => JevContractNames.Of(reason)));
}
