@using PitWall.Domain
@using PitWall.Strategy.TeamDecision
@using PitWall.Web.Components.Shared
@using PitWall.Web.Services
@implements IDisposable
@inject PitWallSession Session
@inject JevDecisionStore Decisions
@inject TeamDecisionService TeamDecisions

@{
    var view = Session.View;
    var state = view.State;
    var loaded = state is not null && TeamDecisions.IsLoaded(state.SessionKey);
    var driver = view.Drivers.GetValueOrDefault(view.FocusDriver);
    var team = loaded ? TeamDecisions.Get(state!.SessionKey, view.FocusDriver) : [];
    var currentLap = state?.Cars.FirstOrDefault(car => car.DriverNumber == view.FocusDriver)?.Lap ?? 0;
    var rows = loaded ? JevVsTeamComparer.Compare(team, Decisions.Get(state!.SessionKey), view.FocusDriver, currentLap) : [];
    var compared = rows.Count(row => row.Jev is not null && row.Outcome != JevVsTeamOutcome.NoTeam);
    var matches = rows.Count(row => row.Outcome == JevVsTeamOutcome.Match);
}

@* Solo pit + compuesto: ritmo y energía reales del equipo no son observables. *@
<section class="panel jev-vs-team">
    <header class="panel-header">
        <h2>Jev vs equipo</h2>
        <span class="panel-meta num">
            @(driver?.Acronym ?? $"#{view.FocusDriver}")
            @if (compared > 0)
            {
                <span title="Vueltas en las que Jev coincide con el equipo / vueltas comparadas"> · @matches/@compared coinciden</span>
            }
        </span>
    </header>

    @if (state is null)
    {
        <p class="empty">Sin sesión cargada.</p>
    }
    else if (!loaded)
    {
        <p class="empty">Cargando stints y paradas…</p>
    }
    else
    {
        <p class="stops">
            <span class="label">Paradas reales</span>
            @if (team.Any(decision => decision.PitCall == PitCall.Box))
            {
                @foreach (var stop in team.Where(decision => decision.PitCall == PitCall.Box))
                {
                    <span class="stop num @(stop.Lap > currentLap ? "upcoming" : null)" title="@(stop.Lap > currentLap ? "Parada real todavía no ocurrida en el replay" : "Parada real")">
                        BOX V@(stop.Lap) @TyreChip(stop.Compound)
                    </span>
                }
            }
            else
            {
                <span class="none">@(team.Count == 0 ? "sin datos de stints ni paradas" : "ninguna")</span>
            }
        </p>

        @if (rows.Count == 0)
        {
            <p class="empty">Jev todavía no dio una estrategia para este piloto.</p>
        }
        else
        {
            <div class="rows">
                <table>
                    <thead>
                        <tr>
                            <th class="num">V</th>
                            <th>Jev</th>
                            <th>Equipo</th>
                            <th>Resultado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in rows)
                        {
                            <tr @key="row.Lap">
                                <td class="num">@row.Lap</td>
                                <td>
                                    @if (row.Jev is { } jev)
                                    {
                                        <span class="call">@PitCallLabel(jev.PitCall)</span>
                                        @if (jev.PitCall is PitCall.Box or PitCall.BoxNextLap)
                                        {
                                            @TyreChip(jev.Compound)
                                        }
                                    }
                                    else
                                    {
                                        <span class="muted">@RaceFormat.Missing</span>
                                    }
                                </td>
                                <td>
                                    @if (row.Team is { } real)
                                    {
                                        <span class="call">@PitCallLabel(real.PitCall)</span>
                                        @if (real.PitCall == PitCall.Box)
                                        {
                                            @TyreChip(real.Compound)
                                        }
                                    }
                                    else
                                    {
                                        <span class="muted">@RaceFormat.Missing</span>
                                    }
                                    @if (row.TeamStop is { } stop && stop.Lap != row.Lap)
                                    {
                                        <span class="ref num" title="Parada real con la que se compara">BOX V@(stop.Lap) @TyreChip(stop.Compound)</span>
                                    }
                                </td>
                                <td>
                                    <span class="outcome @OutcomeClass(row.Outcome)">@OutcomeLabel(row)</span>
                                    @if (row.CompoundDiffers)
                                    {
                                        <span class="compound-differs">otro compuesto</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</section>

@code {
    private int? _loadingSession;

    protected override void OnInitialized()
    {
        Session.Changed += OnChanged;
        Decisions.Published += OnPublished;
    }

    public void Dispose()
    {
        Session.Changed -= OnChanged;
        Decisions.Published -= OnPublished;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // La sesión cambia desde los controles: stints y paradas se cargan la primera vez que el panel la ve.
        if (Session.View.State is not { } state || TeamDecisions.IsLoaded(state.SessionKey) || _loadingSession == state.SessionKey)
        {
            return;
        }

        _loadingSession = state.SessionKey;
        await TeamDecisions.LoadAsync(state.SessionKey);
        _loadingSession = null;
        StateHasChanged();
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private static RenderFragment TyreChip(Compound? compound) => compound is { } value
        ? @<span class="tyre @RaceFormat.CompoundClass(value)" title="@value">@RaceFormat.CompoundLetter(value)</span>
        : @<span class="tyre unknown" title="Compuesto desconocido">?</span>;

    // Las decisiones llegan desde el worker de Jev aunque el replay esté en pausa.
    private void OnPublished(JevDecision decision) => OnChanged();

    private static string PitCallLabel(PitCall? call) => call switch
    {
        PitCall.Box => "BOX",
        PitCall.BoxNextLap => "BOX V+1",
        PitCall.StayOut => "STAY OUT",
        _ => RaceFormat.Missing,
    };

    private static string OutcomeLabel(JevVsTeamRow row) => row.Outcome switch
    {
        JevVsTeamOutcome.Match => "COINCIDE",
        JevVsTeamOutcome.Differs => "DIFIERE",
        JevVsTeamOutcome.JevAhead => $"ADELANTADO {row.OffsetLaps}",
        JevVsTeamOutcome.JevBehind => $"ATRASADO {row.OffsetLaps}",
        JevVsTeamOutcome.NoJev => "SIN JEV",
        _ => "SIN DATOS",
    };

    private static string OutcomeClass(JevVsTeamOutcome outcome) => outcome switch
    {
        JevVsTeamOutcome.Match => "match",
        JevVsTeamOutcome.Differs => "differs",
        JevVsTeamOutcome.JevAhead => "ahead",
        JevVsTeamOutcome.JevBehind => "behind",
        _ => "none",
    };
}
