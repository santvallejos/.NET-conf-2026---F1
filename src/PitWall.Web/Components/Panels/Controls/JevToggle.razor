@using Microsoft.Extensions.Options
@using PitWall.Jev
@using PitWall.Jev.Runtime
@implements IDisposable
@inject IOptionsMonitor<JevOptions> JevOptionsMonitor
@inject JevRuntimeOverrides JevOverrides

@{
    var options = JevOptionsMonitor.CurrentValue;
}

@* Toggle de Jev:Enabled en caliente: aplica a todos los consumidores sin reiniciar (docs/ui.md §4). *@
<div class="jev-toggle">
    <span class="label">Jev</span>
    <button type="button" class="@(options.Enabled ? "on" : "off")" role="switch" aria-checked="@(options.Enabled ? "true" : "false")"
            @onclick="Toggle" title="@(options.Enabled ? "Desactivar Jev" : "Activar Jev")">
        @(options.Enabled ? "ON" : "OFF")
    </button>
    @if (options.Client == JevClientKind.Fake)
    {
        <span class="tag" title="FakeJevClient: decisiones deterministas sin red, costo $0">FAKE</span>
    }
</div>

@code {
    private IDisposable? _optionsSubscription;

    // El hub también puede cambiarlo: se re-renderiza con cada cambio de las opciones.
    protected override void OnInitialized() => _optionsSubscription = JevOptionsMonitor.OnChange(OnOptionsChanged);

    public void Dispose() => _optionsSubscription?.Dispose();

    private void OnOptionsChanged(JevOptions options) => _ = InvokeAsync(StateHasChanged);

    private void Toggle() => JevOverrides.SetEnabled(!JevOptionsMonitor.CurrentValue.Enabled);
}
