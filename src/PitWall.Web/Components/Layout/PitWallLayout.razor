@* Marco de las vistas de la charla (docs/ui.md §3): barra común arriba y la vista activa debajo. Cada vista define
   su propia grilla; las zonas se ubican por grid-area. *@

<div class="pitwall">
    <header class="top-bar">
        @TopBar
    </header>
    <main class="view">
        @ChildContent
    </main>
</div>

@code {
    [Parameter, EditorRequired]
    public RenderFragment? TopBar { get; set; }

    [Parameter, EditorRequired]
    public RenderFragment? ChildContent { get; set; }
}
