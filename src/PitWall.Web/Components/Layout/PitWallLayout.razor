@* Layout de la charla para una pantalla (docs/ui.md §3): barra superior y grilla 3×2 de zonas con pestañas, más una
   fila compacta de widgets. Las zonas se ubican por grid-area: left-top, left-bottom, center-top, center-bottom,
   right-top, right-bottom, widget-center y widget-right. *@

<div class="pitwall">
    <header class="top-bar">
        @TopBar
    </header>
    <main class="grid">
        @ChildContent
    </main>
</div>

@code {
    [Parameter, EditorRequired]
    public RenderFragment? TopBar { get; set; }

    [Parameter, EditorRequired]
    public RenderFragment? ChildContent { get; set; }
}
