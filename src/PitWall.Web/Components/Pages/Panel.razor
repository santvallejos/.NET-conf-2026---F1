@page "/panel"
@page "/panel/{Slug}"
@using PitWall.Web.Components.Shared
@using PitWall.Web.Components.Shared.Views
@inject NavigationManager Navigation

@* Ensayo multi-monitor (docs/ui.md §3): cada vista o panel en su ventana; /panel lista las rutas. Todas las ventanas
   comparten la sesión del servidor, así que controlar el replay en una mueve todas. *@
@if (_entry is not null)
{
    <PageTitle>PitWall · @_entry.Title</PageTitle>

    <StandalonePanel Slug="@_entry.Slug" @rendermode="InteractiveServer" />
}
else if (Slug is null)
{
    <PageTitle>PitWall · Ventanas</PageTitle>

    <nav class="panel-index" aria-label="Ventanas">
        <h1>Ventanas</h1>
        <p class="hint">Cada vista o panel abre en una ventana propia; todas siguen el mismo replay.</p>
        <h2>Vistas</h2>
        <ul>
            @foreach (var view in ViewCatalog.All)
            {
                <li><a href="@view.Route" target="_blank">@view.Key · @view.Title</a><span class="route num">/@view.Route</span></li>
            }
        </ul>
        <h2>Paneles</h2>
        <ul>
            @foreach (var entry in PanelCatalog.All)
            {
                <li><a href="panel/@entry.Slug" target="_blank">@entry.Title</a><span class="route num">/panel/@entry.Slug</span></li>
            }
        </ul>
    </nav>
}

@code {
    private PanelEntry? _entry;

    [Parameter]
    public string? Slug { get; set; }

    protected override void OnParametersSet()
    {
        _entry = PanelCatalog.Find(Slug);
        if (Slug is not null && _entry is null)
        {
            Navigation.NotFound();
        }
    }
}
