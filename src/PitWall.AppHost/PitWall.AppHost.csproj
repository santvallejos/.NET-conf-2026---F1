<Project Sdk="Aspire.AppHost.Sdk/13.6.5">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <UserSecretsId>b1cb3272-e099-4121-917c-d443601aa113</UserSecretsId>
  </PropertyGroup>

  <!--
  Workaround: con AspireUseCliBundle, `dotnet run` delega en `aspire run`, que no recibe la configuración y lanza el
  AppHost (y con él `web`) desde bin/Debug aunque se haya compilado otra. Fuera de Debug se desactiva esa delegación:
  `dotnet run` ejecuta el AppHost de la configuración pedida, que lanza `web` en la misma configuración. DCP y el
  dashboard siguen saliendo del bundle de la CLI (rutas que el SDK embebe al compilar).
  -->
  <PropertyGroup Condition="'$(Configuration)' != 'Debug' and '$(ASPIRE_SUPPRESS_CLI_RUN_HOOK)' == ''">
    <ASPIRE_SUPPRESS_CLI_RUN_HOOK>true</ASPIRE_SUPPRESS_CLI_RUN_HOOK>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PitWall.Web\PitWall.Web.csproj" />
  </ItemGroup>

</Project>
